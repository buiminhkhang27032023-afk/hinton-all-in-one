#!/usr/bin/env python3
"""Measure a VARUN-preset render against the evidence-edit requirements.
usage: varun_qa.py <job>/lam-viec/varun_plan.json out.json"""
import json, sys, collections, os
P = json.load(open(sys.argv[1])); S = P['shots']; T = P['dur']
face = [s for s in S if s['type'] == 'face']; ev = [s for s in S if s['type'] != 'face']
fsec = sum(s['t1'] - s['t0'] for s in face); esec = T - fsec
durs = [round(s['t1'] - s['t0'], 2) for s in ev]
key = lambda s: (os.path.basename(s.get('src', '')) or s['type'] + ':' + '/'.join(l['text'] for l in s.get('lines', [])), s.get('ss'))
distinct = collections.Counter(key(s) for s in ev)
files = collections.Counter(os.path.basename(s.get('src', '')) or 'stat:' + s['lines'][0]['text'] for s in ev)
types = collections.Counter(s['type'] for s in ev)
r = {'duration': T, 'face_sec': round(fsec, 2), 'face_pct': round(100 * fsec / T, 1), 'evidence_pct_fullframe': round(100 * esec / T, 1),
     'face_at': [round(s['t0'], 2) for s in face], 'inserts': len(ev), 'inserts_per_min': round(len(ev) / T * 60, 1),
     'insert_dur_min': min(durs), 'insert_dur_max': max(durs), 'inserts_outside_1_2s': [(round(s['t0'], 2), d) for s, d in zip(ev, durs) if not 0.95 <= d <= 2.05],
     'distinct_visuals': len(distinct), 'distinct_source_files': len(files), 'max_uses_per_source_file': max(files.values()),
     'sources_used_twice': [k for k, v in files.items() if v > 1], 'types': dict(types),
     'transitions': sum(1 for s in S if s.get('tr')), 'transition_times': [round(s['t0'], 2) for s in S if s.get('tr')],
     'sfx': len(P.get('sfx', []))}
json.dump(r, open(sys.argv[2], 'w'), ensure_ascii=False, indent=1); print(json.dumps(r, ensure_ascii=False, indent=1))
