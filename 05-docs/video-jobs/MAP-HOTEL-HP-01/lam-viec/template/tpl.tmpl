<!doctype html>
<html lang="vi"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=1080, height=1920"/>
<title>MAP-HOTEL-HP-01 · Top 5 khách sạn Hải Phòng</title>
<script src="assets/gsap.min.js"></script>
<style>
@font-face{font-family:'BV';src:url('assets/fonts/BeVietnamPro-Medium.ttf');font-weight:500}
@font-face{font-family:'BV';src:url('assets/fonts/BeVietnamPro-SemiBold.ttf');font-weight:600}
@font-face{font-family:'BV';src:url('assets/fonts/BeVietnamPro-Bold.ttf');font-weight:700}
@font-face{font-family:'BV';src:url('assets/fonts/BeVietnamPro-ExtraBold.ttf');font-weight:800}
@font-face{font-family:'BV';src:url('assets/fonts/BeVietnamPro-Black.ttf');font-weight:900}
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1080px;height:1920px;overflow:hidden;background:#070b10;font-family:'BV',sans-serif;color:#fff}
#root{width:1080px;height:1920px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 40%,#13202c,#05080c)}
#mapStage{position:absolute;inset:0;overflow:hidden}
#tilt{position:absolute;inset:0;transform-origin:540px 560px}
#mapWorld{position:absolute;left:0;top:0;width:{MW}px;height:{MH}px;transform-origin:0 0;--z:1}
#mapWorld img.map{width:100%;height:100%;display:block}
svg#arcs{position:absolute;left:0;top:0;overflow:visible}
.arc{fill:none;stroke:#FFE07A;stroke-width:9;stroke-linecap:round}
.arc-glow{fill:none;stroke:rgba(255,170,40,.45);stroke-width:30;stroke-linecap:round}
.mlabel,.pin,.dot{position:absolute;width:0;height:0}
.mlabel span{position:absolute;transform:translate(-50%,-50%) scale(calc(1 / var(--z)));white-space:nowrap;font-weight:800;font-size:30px;letter-spacing:1px;color:rgba(255,255,255,.88);text-shadow:0 2px 8px #000,0 0 3px #000}
.mlabel.river span{color:#9fe3ff;font-size:28px;letter-spacing:6px;font-style:italic}
.pin>*{position:absolute}
.cs{position:absolute;left:0;top:0;width:0;height:0;transform:scale(calc(1 / var(--z)));transform-origin:0 0}
.pin-inner{position:absolute;left:-60px;top:-150px;width:120px;height:150px;opacity:0}
.pin-inner .pin-img{width:120px;height:150px;display:block}
.pin-inner .crown{position:absolute;left:24px;top:-60px;width:72px}
.tagpos{position:absolute;left:60px;top:-14px;width:0;height:0;opacity:0}
.pin-tag{position:absolute;left:0;top:0;transform:translate(-50%,-100%);white-space:nowrap;background:rgba(8,12,18,.88);border:2px solid #FFC93C;color:#fff;font-weight:900;font-size:30px;padding:6px 16px;border-radius:14px}
.qpin{position:absolute;left:-48px;top:-48px;width:96px;height:96px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffffff,#d9e4ef);color:#e5322d;font-weight:900;font-size:64px;line-height:96px;text-align:center;border:5px solid #FFC93C;box-shadow:0 8px 20px rgba(0,0,0,.6);opacity:0}
.ripple{position:absolute;left:-110px;top:-110px;width:220px;height:220px;border-radius:50%;border:6px solid #FFC93C;box-shadow:0 0 30px #FFC93C,inset 0 0 20px rgba(255,201,60,.5);opacity:0}
.ripple-s{width:100%;height:100%}
.dot .dot-in{position:absolute;left:0;top:0;width:34px;height:34px;border-radius:50%;background:#fff;box-shadow:0 0 18px 8px #FFC93C;transform:translate(-50%,-50%) scale(calc(1 / var(--z)));opacity:0}
.shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,0) 18%,rgba(0,0,0,0) 45%,rgba(0,0,0,.55) 75%,rgba(0,0,0,.75) 100%);z-index:5}
.vig{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 35%,transparent 45%,rgba(0,0,0,.55) 100%);z-index:6}
#flash{position:absolute;inset:0;background:#fff;opacity:0;z-index:60;pointer-events:none}
.ui{position:absolute;inset:0;z-index:20}
/* hook title */
#title{position:absolute;left:40px;right:40px;top:300px;text-align:center;z-index:30}
.t-chip{display:inline-block;background:#e5322d;color:#fff;font-weight:900;font-size:34px;padding:10px 26px;border-radius:999px;letter-spacing:1px;box-shadow:0 8px 24px rgba(229,50,45,.5)}
.t-top5{font-size:230px;font-weight:900;line-height:1;margin-top:18px;background:linear-gradient(180deg,#FFF6B8 0%,#FFC93C 45%,#F08A00 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:4px rgba(60,30,0,.55);filter:drop-shadow(0 10px 24px rgba(0,0,0,.7))}
.t-l2{font-size:76px;font-weight:900;line-height:1.05;text-shadow:0 6px 18px #000,0 0 4px #000}
.t-l3{font-size:118px;font-weight:900;line-height:1.05;margin-top:6px;text-shadow:0 8px 22px #000,0 0 4px #000}
.t-l3 span{display:inline-block;border-bottom:12px solid #e5322d;padding:0 10px}
.t-sub{display:inline-flex;align-items:center;gap:12px;margin-top:26px;background:rgba(255,255,255,.95);color:#111;font-weight:800;font-size:38px;padding:12px 28px;border-radius:18px;box-shadow:0 10px 28px rgba(0,0,0,.5)}
.t-sub img{width:34px}
/* rule panel */
#rule{position:absolute;left:40px;right:40px;top:250px;opacity:0;z-index:30}
.panel{background:rgba(8,12,18,.95);border:3px solid rgba(255,201,60,.8);border-radius:32px;padding:34px 36px;box-shadow:0 20px 60px rgba(0,0,0,.6)}
.p-h{font-size:58px;font-weight:900;color:#FFC93C;text-align:center;letter-spacing:1px}
.p-row{display:flex;align-items:center;gap:20px;margin-top:24px;font-size:42px;font-weight:800;line-height:1.2}
.p-ic{flex:0 0 84px;height:84px;border-radius:22px;background:#FFC93C;color:#111;display:flex;align-items:center;justify-content:center;font-size:44px;font-weight:900}
.p-date{margin-top:26px;text-align:center;font-size:32px;font-weight:700;color:#cfe6ff}
/* rank ladder */
#ladder{position:absolute;top:150px;left:0;right:0;display:flex;justify-content:center;gap:16px;z-index:40;opacity:0}
.lad{width:84px;height:84px;border-radius:50%;background:rgba(0,0,0,.6);border:3px solid rgba(255,255,255,.55);display:flex;align-items:center;justify-content:center;font-size:42px;font-weight:900;color:#fff}
.lad-l{position:absolute;top:118px;left:0;right:0;text-align:center;font-size:26px;font-weight:800;letter-spacing:6px;color:rgba(255,255,255,.8);z-index:40;opacity:0}
/* splash */
.splash{position:absolute;left:0;right:0;top:250px;text-align:center;z-index:45;opacity:0;pointer-events:none}
.splash .s1{font-size:64px;font-weight:900;letter-spacing:10px;color:#fff;text-shadow:0 6px 20px #000}
.splash .s2{font-size:300px;font-weight:900;line-height:.95;background:linear-gradient(180deg,#FFF6B8,#FFC93C 50%,#F08A00);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:5px rgba(60,30,0,.6);filter:drop-shadow(0 12px 30px rgba(0,0,0,.8))}
/* card */
.card{position:absolute;left:40px;right:120px;top:1030px;display:flex;gap:22px;align-items:center;padding:26px 26px;border-radius:32px;background:linear-gradient(160deg,rgba(14,20,30,.94),rgba(6,9,14,.94));border:3px solid rgba(255,201,60,.85);box-shadow:0 22px 60px rgba(0,0,0,.65),0 0 40px rgba(255,201,60,.18);opacity:0;z-index:35}
.medal{flex:0 0 150px;height:150px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffffff,#cfd8e3 60%,#8d99a8);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#1b2430;border:6px solid #fff;box-shadow:0 8px 20px rgba(0,0,0,.5)}
.medal.gold{background:radial-gradient(circle at 35% 30%,#FFF6B8,#FFC93C 55%,#C77700);color:#3a2000}
.medal-top{font-size:24px;font-weight:900;letter-spacing:3px}
.medal-n{font-size:92px;font-weight:900;line-height:.9}
.cbody{flex:1;min-width:0}
.cname{font-size:50px;font-weight:900;line-height:1.08;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.carea{font-size:30px;font-weight:700;color:rgba(255,255,255,.82);margin-top:6px;display:flex;align-items:center;gap:8px;white-space:nowrap}
.carea .gp{width:24px}
.crow{display:flex;align-items:center;gap:16px;margin-top:12px}
.starwrap{position:relative;width:240px;height:44px;flex:0 0 240px}
.st-empty,.st-gold{position:absolute;left:0;top:0;display:flex;height:44px;overflow:hidden;white-space:nowrap}
.st-gold{width:0}
.cnum{font-size:64px;font-weight:900;color:#FFC93C;line-height:1}
.cnum small{font-size:32px;color:rgba(255,255,255,.7);margin-left:4px}
.crev{font-size:36px;font-weight:800;margin-top:10px;white-space:nowrap}
.crev b{color:#FFC93C}
.gg{color:#8ab4ff}
.chips{display:flex;gap:10px;margin-top:12px}
.chip{font-size:24px;font-weight:800;padding:6px 14px;border-radius:999px;background:rgba(255,201,60,.18);border:2px solid rgba(255,201,60,.7);color:#FFE29A;white-space:nowrap}
.chip.c2{background:rgba(138,180,255,.15);border-color:rgba(138,180,255,.7);color:#cfe0ff}
/* bubbles */
.bubble{position:absolute;left:40px;width:760px;padding:20px 26px 18px;border-radius:30px;background:#fff;color:#111;box-shadow:0 16px 40px rgba(0,0,0,.55);opacity:0;z-index:34;transform-origin:20% 0%}
.bubble.b0{top:606px}
.bubble.b0:before{content:'';position:absolute;left:120px;top:-26px;border:16px solid transparent;border-bottom:14px solid #fff;border-top:0;border-width:0 18px 28px 18px}
.bubble.b1{top:838px;left:200px;width:740px;transform-origin:80% 0%}
.bhead{display:flex;align-items:center;gap:14px}
.av{width:58px;height:58px}
.bname{font-size:26px;font-weight:800;color:#333}
.bstars{display:flex;margin-top:2px}
.btext{font-size:38px;font-weight:800;line-height:1.25;margin-top:10px;color:#111}
.blabel{font-size:22px;font-weight:700;color:#5f6b7a;margin-top:8px}
.b1 .bhead{display:none}
.b1 .btext{margin-top:0}
/* subtitles */
#subs{position:absolute;left:50px;right:130px;top:1390px;height:150px;z-index:50}
.cue{position:absolute;left:0;right:0;top:0;text-align:center;font-size:56px;font-weight:900;line-height:1.18;color:#fff;-webkit-text-stroke:9px #000;paint-order:stroke fill;text-shadow:0 6px 16px rgba(0,0,0,.6);opacity:0}
.cue .hl{color:#FFD23F}
/* cta */
#ctaQ{position:absolute;left:40px;right:40px;top:250px;text-align:center;z-index:40;opacity:0}
.q1{display:inline-block;font-size:80px;font-weight:900;line-height:1.1;background:#e5322d;padding:10px 28px;border-radius:20px;box-shadow:0 12px 30px rgba(0,0,0,.5)}
.q2{margin-top:18px;font-size:40px;font-weight:900;color:#FFC93C;text-shadow:0 4px 14px #000;opacity:0}
#recap{position:absolute;left:40px;right:120px;top:900px;z-index:40;opacity:0}
.rrow{display:flex;align-items:center;gap:16px;background:rgba(8,12,18,.88);border:2px solid rgba(255,201,60,.55);border-radius:20px;padding:12px 20px;margin-bottom:10px;opacity:0}
.rr{flex:0 0 74px;font-size:40px;font-weight:900;color:#FFC93C}
.rn{flex:1;font-size:36px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rs{display:flex;align-items:center;gap:6px;font-size:38px;font-weight:900;color:#FFC93C}
#rrow-melia{border-color:#FFC93C;background:linear-gradient(90deg,rgba(255,201,60,.32),rgba(8,12,18,.9))}
/* confetti */
.cf{position:absolute;width:18px;height:28px;border-radius:4px;opacity:0;z-index:46}
/* footer */
.footer{position:absolute;left:24px;right:24px;bottom:22px;display:flex;justify-content:space-between;align-items:center;z-index:55;pointer-events:none}
.disc{font-size:22px;font-weight:700;color:rgba(255,255,255,.9);background:rgba(0,0,0,.6);padding:6px 14px;border-radius:10px}
.attr{font-size:18px;font-weight:600;color:rgba(255,255,255,.7);background:rgba(0,0,0,.45);padding:5px 10px;border-radius:8px}
</style></head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{DUR}" data-width="1080" data-height="1920" data-fps="30">
  <div id="mapStage" class="clip" data-start="0" data-duration="{DUR}" data-track-index="0">
   <div id="tilt">
    <div id="mapWorld">
      <img class="map" src="assets/map/haiphong-sat-z16.jpg" width="{MW}" height="{MH}" alt=""/>
      <svg id="arcs" width="{MW}" height="{MH}" viewBox="0 0 {MW} {MH}"><!--ARCS--></svg>
      <!--LANDMARKS-->
      <!--DOTS-->
      <!--PINS-->
    </div>
   </div>
  </div>
  <div class="shade"></div><div class="vig"></div>
  <div class="ui">
    <div id="title">
      <div class="t-chip">REVIEW THẬT TỪ GOOGLE MAPS</div>
      <div class="t-top5">TOP 5</div>
      <div class="t-l2">KHÁCH SẠN 5 SAO</div>
      <div class="t-l3"><span>HẢI PHÒNG</span></div>
      <div class="t-sub"><img src="assets/icons/gpin.svg"/>Điểm Google Maps cao nhất</div>
    </div>
    <div id="rule"><div class="panel">
      <div class="p-h">CÁCH XẾP HẠNG</div>
      <div class="p-row"><div class="p-ic">★</div><div>Điểm Google Maps<br/>từ thấp → cao: #5 → #1</div></div>
      <div class="p-row"><div class="p-ic">=</div><div>Bằng điểm: nhiều review<br/>hơn thì xếp trên</div></div>
      <div class="p-date">Khách sạn 5 sao nội thành · tra ngày 06/10/2026</div>
    </div></div>
    <div class="lad-l" id="ladL">BẢNG XẾP HẠNG</div>
    <div id="ladder"><!--LADDER--></div>
    <div class="splash" id="spl-5"><div class="s1">HẠNG</div><div class="s2">#5</div></div>
    <div class="splash" id="spl-4"><div class="s1">HẠNG</div><div class="s2">#4</div></div>
    <div class="splash" id="spl-3"><div class="s1">HẠNG</div><div class="s2">#3</div></div>
    <div class="splash" id="spl-2"><div class="s1">HẠNG</div><div class="s2">#2</div></div>
    <div class="splash" id="spl-1"><div class="s1">TOP 1</div><div class="s2">#1</div></div>
    <!--BUBBLES-->
    <!--CARDS-->
    <div id="ctaQ"><div class="q1">BẠN CHỌN<br/>KHÁCH SẠN NÀO?</div><div class="q2" id="q2">LƯU VIDEO · THEO DÕI HINTON MEDIA</div></div>
    <div id="recap"><!--RECAP--></div>
    <div id="confetti"></div>
    <div id="subs"><!--CUES--></div>
  </div>
  <div id="flash"></div>
  <div class="footer"><div class="disc">{DISC}</div><div class="attr">{ATTR}</div></div>
</div>
<script>
const D=/*DATA*/;
const W=D.W,FY=D.FY;
const tl=gsap.timeline({paused:true});
function cam(px,py,s,fy){fy=fy||FY;return {x:W/2-px*s,y:fy-py*s,scale:s,'--z':s};}
const C=D.center;
const OV0=cam(C[0],C[1],0.50,980), OV1=cam(C[0],C[1],0.58,980);
gsap.set('#mapWorld',Object.assign({transformOrigin:'0 0'},OV0));
gsap.set('#tilt',{transformPerspective:1800,rotationX:0,transformOrigin:'540px 560px'});
let curCam=OV1;
const S=D.scenes;
const R=D.ranked;
const hookEnd=S.rule.start;
// ---------- HOOK ----------
tl.fromTo('#mapWorld',OV0,Object.assign({duration:hookEnd+0.4,ease:'sine.inOut'},OV1),0);
tl.fromTo('.t-top5',{scale:1.18},{scale:1,duration:0.6,ease:'back.out(2.2)'},0);
tl.fromTo('.t-chip',{y:-10},{y:0,duration:0.4},0);
tl.fromTo('.t-l3 span',{scale:1.06},{scale:1,duration:0.5,ease:'power2.out'},0.1);
if(S.hook.sents[1]){const t=S.hook.sents[1][0];tl.fromTo('.t-top5',{scale:1},{scale:1.12,duration:0.18,yoyo:true,repeat:1,ease:'power1.inOut'},t);}
R.forEach((h,i)=>{
  tl.fromTo('#qpin-'+h.id,{opacity:0,scale:0},{opacity:1,scale:1,duration:0.35,ease:'back.out(2.5)'},0.35+i*0.22);
});
tl.to('#title',{opacity:0,y:-120,scale:0.92,duration:0.35,ease:'power2.in'},hookEnd-0.15);
// ---------- RULE ----------
tl.fromTo('#rule',{opacity:0,y:90},{opacity:1,y:0,duration:0.4,ease:'back.out(1.5)'},hookEnd);
tl.fromTo('#rule .p-row',{opacity:0,x:-40},{opacity:1,x:0,duration:0.3,stagger:0.35},hookEnd+0.25);
tl.to('#rule',{opacity:0,y:-80,duration:0.25,ease:'power2.in'},S[R[0].id].start-0.75);
tl.fromTo(['#ladder','#ladL'],{opacity:0,y:-30},{opacity:1,y:0,duration:0.35},S[R[0].id].start-0.5);
tl.fromTo('#tilt',{rotationX:0},{rotationX:14,duration:1.0,ease:'power2.inOut'},S[R[0].id].start-0.6);
// ---------- HOTELS ----------
const sceneOrder=['hook','rule'].concat(R.map(h=>h.id)).concat(['cta']);
function nextStart(id){const i=sceneOrder.indexOf(id);return S[sceneOrder[i+1]].start;}
function fmtR(v){return v.toFixed(1).replace('.',',');}
function fmtN(v){return Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g,'.');}
R.forEach((h,i)=>{
  const sc=S[h.id], s=sc.start, e=nextStart(h.id);
  const z=1.22, z2=1.34;
  const to=cam(h.px,h.py,z), hold=cam(h.px,h.py,z2);
  const fromC=curCam;
  const mx=(fromC.x+to.x)/2, my=(fromC.y+to.y)/2;
  // mid camera: zoom out around midpoint of the two world points
  const p0x=(W/2-fromC.x)/fromC.scale, p0y=(FY-fromC.y)/fromC.scale;
  const midS=Math.min(fromC.scale,z)*0.62;
  const mid=cam((p0x+h.px)/2,(p0y+h.py)/2,midS);
  const fs=s-0.62, fd=1.12;
  tl.fromTo('#mapWorld',fromC,{keyframes:[Object.assign({duration:fd*0.5,ease:'power2.in'},mid),Object.assign({duration:fd*0.5,ease:'power2.out'},to)]},fs);
  tl.fromTo('#mapWorld',to,Object.assign({duration:Math.max(0.5,(e-0.62)-(s+0.5)),ease:'none'},hold),s+0.5);
  curCam=hold;
  // whip blur + flash
  tl.fromTo('#mapStage',{filter:'blur(0px)'},{filter:'blur(7px)',duration:0.36,ease:'power1.in'},fs+0.08);
  tl.fromTo('#mapStage',{filter:'blur(7px)'},{filter:'blur(0px)',duration:0.34,ease:'power1.out'},fs+0.5);
  tl.fromTo('#flash',{opacity:0},{opacity:0.28,duration:0.07},s-0.07);
  tl.to('#flash',{opacity:0,duration:0.22},s);
  // arc + travelling dot
  const arc=D.arcs.find(a=>a.to===h.id);
  if(arc){
    const p=document.getElementById('arc-'+arc.id), g=document.getElementById('arcg-'+arc.id);
    const L=p.getTotalLength();
    gsap.set([p,g],{strokeDasharray:L,strokeDashoffset:L});
    tl.fromTo([p,g],{strokeDashoffset:L},{strokeDashoffset:0,duration:fd,ease:'power2.inOut'},fs);
    const kf=arc.pts.map(q=>({x:q[0],y:q[1],duration:fd/arc.pts.length,ease:'none'}));
    tl.fromTo('#dot-'+arc.id,{x:arc.pts[0][0],y:arc.pts[0][1]},{keyframes:kf},fs);
    tl.fromTo('#dot-'+arc.id+' .dot-in',{opacity:0},{opacity:1,duration:0.1},fs);
    tl.to('#dot-'+arc.id+' .dot-in',{opacity:0,duration:0.2},fs+fd);
  }
  // splash rank
  tl.fromTo('#spl-'+h.rank,{opacity:0,scale:2.6,y:0},{opacity:1,scale:1,duration:0.3,ease:'back.out(1.7)'},s-0.04);
  tl.to('#spl-'+h.rank,{opacity:0,y:-150,scale:0.3,duration:0.35,ease:'power2.in'},s+0.78);
  tl.fromTo('#tilt',{x:0},{keyframes:[{x:-16,duration:0.05},{x:13,duration:0.05},{x:-8,duration:0.05},{x:4,duration:0.05},{x:0,duration:0.05}]},s+0.24);
  // ladder
  tl.fromTo('#lad-'+h.id,{scale:1,backgroundColor:'rgba(0,0,0,0.6)',color:'#ffffff',borderColor:'rgba(255,255,255,0.55)'},{scale:1.32,backgroundColor:'#FFC93C',color:'#111111',borderColor:'#ffffff',duration:0.25,ease:'back.out(2)'},s);
  tl.to('#lad-'+h.id,{scale:1,backgroundColor:'rgba(255,201,60,0.28)',color:'#FFC93C',borderColor:'#FFC93C',duration:0.25},e-0.4);
  // pin drop
  tl.to('#qpin-'+h.id,{opacity:0,scale:0,duration:0.2},s+0.2);
  tl.fromTo('#pinin-'+h.id,{opacity:0,y:-300},{opacity:1,y:0,duration:0.55,ease:'bounce.out'},s+0.25);
  for(let k=0;k<4;k++){
    const t0=s+0.62+k*1.6; if(t0>e-0.5)break;
    tl.fromTo('#rip-'+h.id,{opacity:0.95,scale:0.25},{opacity:0,scale:2.2,duration:1.1,ease:'power2.out'},t0);
    tl.fromTo('#rip2-'+h.id,{opacity:0.7,scale:0.25},{opacity:0,scale:2.2,duration:1.1,ease:'power2.out'},t0+0.3);
  }
  // card
  const card='#card-'+h.id;
  tl.fromTo(card,{opacity:0,y:160},{opacity:1,y:0,duration:0.45,ease:'back.out(1.4)'},s+0.5);
  tl.fromTo('#stg-'+h.id,{width:0},{width:240*h.rating/5,duration:0.9,ease:'power2.out'},s+0.62);
  const ro={v:0}, rn=document.getElementById('rnum-'+h.id);
  tl.fromTo(ro,{v:0},{v:h.rating,duration:0.9,ease:'power2.out',onUpdate:()=>{rn.textContent=fmtR(ro.v);}},s+0.62);
  const vo={v:0}, vn=document.getElementById('rev-'+h.id);
  tl.fromTo(vo,{v:0},{v:h.reviews,duration:1.0,ease:'power2.out',onUpdate:()=>{vn.textContent=fmtN(vo.v);}},s+0.7);
  // bubbles synced to quote sentence
  const qs=(sc.sents[2]||sc.sents[sc.sents.length-1]);
  for(let b=0;b<h.nq;b++){
    const id='#bub-'+h.id+'-'+b;
    const t0=b===0?qs[0]-0.1:Math.min(qs[0]+(qs[1]-qs[0])*0.35,qs[0]+1.2);
    tl.fromTo(id,{opacity:0,scale:0.55,y:30},{opacity:1,scale:1,y:0,duration:0.35,ease:'back.out(2)'},t0);
    tl.fromTo(id+' .w',{opacity:0.25},{opacity:1,duration:0.1,stagger:0.045},t0+0.1);
  }
  // exit
  const ex=['#card-'+h.id].concat([...Array(h.nq).keys()].map(b=>'#bub-'+h.id+'-'+b));
  tl.to(ex,{opacity:0,y:70,duration:0.28,ease:'power2.in'},e-0.42);
  tl.fromTo('#tag-'+h.id,{opacity:0,scale:0.6},{opacity:1,scale:1,duration:0.25},e-0.3);
  if(h.rank===1){
    // confetti burst
    const box=document.getElementById('confetti');
    const cols=['#FFC93C','#ffffff','#e5322d','#8ab4ff','#7CFFB2'];
    let seed=7; const rnd=()=>{seed=(seed*16807)%2147483647;return seed/2147483647;};
    for(let k=0;k<46;k++){
      const d=document.createElement('div'); d.className='cf'; d.style.background=cols[k%cols.length];
      d.style.left='540px'; d.style.top='520px'; box.appendChild(d);
      const ang=rnd()*Math.PI*2, r=260+rnd()*420;
      tl.fromTo(d,{opacity:1,x:0,y:0,rotation:0},{immediateRender:false,x:Math.cos(ang)*r,y:Math.sin(ang)*r*0.8+420,rotation:(rnd()-0.5)*720,opacity:0,duration:1.6+rnd()*0.6,ease:'power2.out'},s+0.3);
    }
    tl.fromTo('#rip-'+h.id,{borderColor:'#FFC93C'},{borderColor:'#FFF6B8',duration:0.01},s);
  }
});
// ---------- CTA ----------
const cs=S.cta.start;
const OVE=cam(C[0],C[1]+260,0.52,900);
tl.fromTo('#mapWorld',curCam,Object.assign({duration:1.2,ease:'power3.inOut'},OVE),cs-0.5);
tl.fromTo('#tilt',{rotationX:14},{rotationX:6,duration:1.2,ease:'power2.inOut'},cs-0.5);
tl.to(['#ladder','#ladL'],{opacity:0,duration:0.3},cs-0.3);
tl.to('.tagpos',{opacity:0,duration:0.2},cs-0.05);
tl.to('.pin-inner',{scale:0.62,transformOrigin:'50% 100%',duration:0.4},cs-0.3);
tl.fromTo('#ctaQ',{opacity:0,scale:0.7},{opacity:1,scale:1,duration:0.4,ease:'back.out(2)'},cs);
tl.fromTo('#recap',{opacity:0,y:120},{opacity:1,y:0,duration:0.4,ease:'power2.out'},cs+0.25);
tl.fromTo('.rrow',{opacity:0,x:-60},{opacity:1,x:0,duration:0.25,stagger:0.12},cs+0.35);
if(S.cta.sents[1]) tl.fromTo('#q2',{opacity:0,y:20},{opacity:1,y:0,duration:0.3},S.cta.sents[1][0]);
D.arcs.forEach(a=>{});
// ---------- SUBTITLES ----------
D.cues.forEach((c,i)=>{
  const nx=D.cues[i+1]; const end=nx?Math.min(c.end+0.15,nx.start):c.end+0.4;
  tl.fromTo('#cue'+i,{opacity:i===0?1:0,scale:i===0?1:0.86},{opacity:1,scale:1,duration:0.1,ease:'back.out(2)'},c.start);
  tl.set('#cue'+i,{opacity:0},end);
});
tl.set({},{},D.DUR);
window.__timelines=window.__timelines||{};window.__timelines['main']=tl;
</script>
</body></html>
