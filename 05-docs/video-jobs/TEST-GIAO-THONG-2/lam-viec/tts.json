    },
    {
      "i": 11,
      "text": "Vì giờ, mọi chiếc xe trước mặt đều có quyền đi trước bạn.",
      "start": 15.3491,
      "end": 17.8161,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/72cd3da840b39ee4.trim.wav"
    },
    {
      "i": 12,
      "text": "Một cú lấn làn sai nhịp là đối đầu trực diện.",
