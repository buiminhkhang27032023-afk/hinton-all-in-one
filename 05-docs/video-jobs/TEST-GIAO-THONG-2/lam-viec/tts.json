      "end": 13.7746,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/3636ea9c4d780d5b.trim.wav"
    },
    {
      "i": 10,
      "text": "Và đó mới là lúc nguy hiểm nhất.",
