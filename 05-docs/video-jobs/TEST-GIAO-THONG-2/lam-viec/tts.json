      "end": 10.377,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/ad57fa59ed8ee088.trim.wav"
    },
    {
      "i": 8,
      "text": "Nhưng chờ mãi cũng không phải cách.",
