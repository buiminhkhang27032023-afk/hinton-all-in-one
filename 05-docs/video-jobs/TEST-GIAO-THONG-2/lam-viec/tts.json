      "end": 9.365,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/3562ec93c48719e9.trim.wav"
    },
    {
      "i": 7,
      "text": "Phản xạ đúng đấy.",
