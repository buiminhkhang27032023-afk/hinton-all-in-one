{
  "sentences": [
    {
      "i": 0,
      "text": "Thấy cái này mà không giảm ga?",
      "start": 0.0,
      "end": 1.311,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/708d96e24fa09e71.trim.wav"
    },
    {
      "i": 1,
      "text": "Bạn đang làm sai.",
      "start": 1.4206,
      "end": 2.4156,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/491f9855cda2b7ff.trim.wav"
    },
    {
      "i": 2,
      "text": "Nó không nằm đó cho vui.",
      "start": 2.5171,
      "end": 3.7331,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/3f670e6eab93b9a2.trim.wav"
    },
    {
      "i": 3,
      "text": "Phía sau nó là thứ bạn không muốn đâm vào.",
      "start": 3.8372,
      "end": 5.6772,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/05bd8f0d4a557f7b.trim.wav"
    },
    {
      "i": 4,
      "text": "Đường trơn thế này, phanh gấp là trượt.",
      "start": 5.7759,
      "end": 7.4169,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/dab3b89ca08f389f.trim.wav"
    },
    {
      "i": 5,
      "text": "Nên tài xế dừng hẳn.",
      "start": 7.5369,
      "end": 8.6139,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/5fb41e231f6f4bfd.trim.wav"
    },
    {
      "i": 6,
      "text": "Và chờ.",
      "start": 8.717,
      "end": 9.365,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/3562ec93c48719e9.trim.wav"
    },
    {
      "i": 7,
      "text": "Phản xạ đúng đấy.",
      "start": 9.485,
      "end": 10.377,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/ad57fa59ed8ee088.trim.wav"
    },
    {
      "i": 8,
      "text": "Nhưng chờ mãi cũng không phải cách.",
      "start": 10.4822,
      "end": 12.0392,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/e97411f018645bf3.trim.wav"
    },
    {
      "i": 9,
      "text": "Lối thoát duy nhất là làn ngược chiều.",
      "start": 12.1496,
      "end": 13.7746,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/3636ea9c4d780d5b.trim.wav"
    },
    {
      "i": 10,
      "text": "Và đó mới là lúc nguy hiểm nhất.",
      "start": 13.884,
      "end": 15.234,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/1006c8a0800805df.trim.wav"
    },
    {
      "i": 11,
      "text": "Vì giờ, mọi chiếc xe trước mặt đều có quyền đi trước bạn.",
      "start": 15.3491,
      "end": 17.8161,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/72cd3da840b39ee4.trim.wav"
    },
    {
      "i": 12,
      "text": "Một cú lấn làn sai nhịp là đối đầu trực diện.",
      "start": 17.9222,
      "end": 19.8972,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/45ddafefaac0be9c.trim.wav"
    },
    {
      "i": 13,
      "text": "Mặt đường ướt không cho bạn cơ hội thứ hai.",
      "start": 20.0087,
      "end": 21.8367,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/c1a2116689ec7ac7.trim.wav"
    },
    {
      "i": 14,
      "text": "Bạn chỉ là khách trên làn của họ.",
      "start": 21.9427,
      "end": 23.3967,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/2a104a4aa85f2cfe.trim.wav"
    },
    {
      "i": 15,
      "text": "Đừng tranh với họ.",
      "start": 23.5023,
      "end": 24.3213,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/225aeb3d89b963f7.trim.wav"
    },
    {
      "i": 16,
      "text": "Chậm lại.",
      "start": 24.4254,
      "end": 24.8914,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/86d8d67552eca868.trim.wav"
    },
    {
      "i": 17,
      "text": "Nhường.",
      "start": 25.0058,
      "end": 25.4828,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/5d77a59a130e806f.trim.wav"
    },
    {
      "i": 18,
      "text": "Rồi mới nhích lên.",
      "start": 25.5873,
      "end": 26.6963,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/a88c21af14cbbed7.trim.wav"
    },
    {
      "i": 19,
      "text": "Vội một giây, người cần đặt tam giác tiếp theo là bạn.",
      "start": 26.7999,
      "end": 29.1675,
      "file": "/workspace/video-jobs/TEST-GIAO-THONG-2/lam-viec/tts_cache/b448d27fa9631ea6.trim.wav"
    }
  ],
