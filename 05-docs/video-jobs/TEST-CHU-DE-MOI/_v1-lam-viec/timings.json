{
  "sentences": [
    {
      "i": 0,
      "text": "Thanh thép đang đỏ trên đe.",
      "start": 0.0,
      "end": 1.272,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/11a566e3b3576a84.trim.wav"
    },
    {
      "i": 1,
      "text": "Kìm kẹp một đầu bên phải.",
      "start": 1.3772,
      "end": 2.5632,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/b8e80f8a3b0ad8b6.trim.wav"
    },
    {
      "i": 2,
      "text": "Búa giáng xuống từ trên.",
      "start": 2.6815,
      "end": 3.8605,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/c10140854038fde1.trim.wav"
    },
    {
      "i": 3,
      "text": "Tia lửa bắn khi búa chạm.",
      "start": 3.9674,
      "end": 5.2434,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/3e6971c0fe84ae79.trim.wav"
    },
    {
      "i": 4,
      "text": "Thanh nằm ngang, sáng cả thân.",
      "start": 5.3507,
      "end": 6.7467,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/471fd6f6f75cc056.trim.wav"
    },
    {
      "i": 5,
      "text": "Rồi thanh bị uốn cong.",
      "start": 6.8547,
      "end": 8.0417,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/06b4640a8a82cd8f.trim.wav"
    },
    {
      "i": 6,
      "text": "Một đầu thò khỏi mép đe.",
      "start": 8.1449,
      "end": 9.3579,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/0733cde36108d4bb.trim.wav"
    },
    {
      "i": 7,
      "text": "Đầu đó vẫn đỏ rực.",
      "start": 9.4645,
      "end": 10.4335,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/2aeacccbeea1fa15.trim.wav"
    },
    {
      "i": 8,
      "text": "Búa vung tiếp, chỉ thấy vệt mờ.",
      "start": 10.5399,
      "end": 11.9599,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/35941808d7b97331.trim.wav"
    },
    {
      "i": 9,
      "text": "Người thợ mặc áo sáng.",
      "start": 12.067,
      "end": 13.192,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/f96b9f4dccd684bd.trim.wav"
    },
    {
      "i": 10,
      "text": "Chỉ thấy tay, búa và kìm.",
      "start": 13.2978,
      "end": 14.4578,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/e15a65796ee8efbb.trim.wav"
    },
    {
      "i": 11,
      "text": "Không thấy mặt người trong khung.",
      "start": 14.562,
      "end": 15.997,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/93ccb6e2f12b56a7.trim.wav"
    },
    {
      "i": 12,
      "text": "Mặt đe sần, có vết lõm.",
      "start": 16.1052,
      "end": 17.2482,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/1f45f61be54d71f1.trim.wav"
    },
    {
      "i": 13,
      "text": "Nền phía sau thì tối.",
      "start": 17.3506,
      "end": 18.3766,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/59ebe1b52f94223b.trim.wav"
    },
    {
      "i": 14,
      "text": "Cuối clip, đầu thanh tròn hơn.",
      "start": 18.4803,
      "end": 19.8583,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/15954318da7f9cfb.trim.wav"
    },
    {
      "i": 15,
      "text": "Kìm không rời thanh.",
      "start": 19.9614,
      "end": 21.0174,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/4b9cbd25c885044e.trim.wav"
    },
    {
      "i": 16,
      "text": "Đe chiếm gần hết hình.",
      "start": 21.1326,
      "end": 22.0736,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/b4b108820a0b63ca.trim.wav"
    },
    {
      "i": 17,
      "text": "Thép sáng hơn mọi thứ quanh.",
      "start": 22.1819,
      "end": 23.4259,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/c257cc78b58d4204.trim.wav"
    },
    {
      "i": 18,
      "text": "Nhịp búa lặp đi lặp lại.",
      "start": 23.53,
      "end": 24.678,
      "file": "/workspace/video-jobs/TEST-CHU-DE-MOI/lam-viec/tts_cache/b30ef6d703bfc62b.trim.wav"
    },
    {
      "i": 19,
