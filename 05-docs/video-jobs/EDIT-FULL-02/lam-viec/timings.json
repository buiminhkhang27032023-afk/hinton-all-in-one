{
  "sentences": [
    {
      "i": 0,
      "text": "OpenAI vừa tung AI làm việc thay bạn hai bốn trên bảy.",
      "start": 0.0,
      "end": 2.47,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/b78f1e909c643ee1.trim.wav"
    },
    {
      "i": 1,
      "text": "Nhưng đó mới chỉ là một nửa câu chuyện.",
      "start": 2.5725,
      "end": 4.1985,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/3c2752e2b6221171.trim.wav"
    },
    {
      "i": 2,
      "text": "Nửa kia là mô hình mới giá chỉ bằng một phần năm.",
      "start": 4.309,
      "end": 6.435,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/cf49a7eda9982204.trim.wav"
    },
    {
      "i": 3,
      "text": "Tất cả ra mắt tại DevDay ngày hai mươi chín tháng chín.",
      "start": 6.5239,
      "end": 8.7969,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/13aec8768686a0c1.trim.wav"
    },
    {
      "i": 4,
      "text": "ChatGPT giờ có một phẩy hai tỷ người dùng mỗi tuần.",
      "start": 8.9014,
      "end": 11.1894,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/3f2c7b5de1fe1bc5.trim.wav"
    },
    {
      "i": 5,
      "text": "Tên chúng là dots, chạy bằng GPT sáu Astra.",
      "start": 11.3011,
      "end": 13.2841,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/0aeebe0a8a15fe12.trim.wav"
    },
    {
      "i": 6,
      "text": "Mỗi dot có máy tính đám mây và trình duyệt riêng.",
      "start": 13.3935,
      "end": 15.5405,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/fbf581932638fae2.trim.wav"
    },
    {
      "i": 7,
      "text": "Nó kết nối được hơn bốn nghìn ứng dụng.",
      "start": 15.6212,
      "end": 17.3252,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/929d382f5ec1934b.trim.wav"
    },
    {
      "i": 8,
      "text": "Giao một mục tiêu, nó tự làm cả ngày lẫn đêm.",
      "start": 17.4353,
      "end": 19.3583,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/21e57188fb53d1d2.trim.wav"
    },
    {
      "i": 9,
      "text": "Nhắn tin cho nó qua ChatGPT, Slack hay Teams.",
      "start": 19.4627,
      "end": 21.5807,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/c12e93cd618837ef.trim.wav"
    },
    {
      "i": 10,
      "text": "Nhưng đó chưa phải phần điên rồ nhất.",
      "start": 21.6993,
      "end": 23.3073,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/3eb79b12c16f0486.trim.wav"
    },
    {
      "i": 11,
      "text": "GPT sáu chấm một Sol thông minh gần bằng Astra.",
      "start": 23.4116,
      "end": 25.6046,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/5be525033e1d03d2.trim.wav"
    },
    {
      "i": 12,
      "text": "Giá chỉ hai đô mỗi triệu token đầu vào.",
      "start": 25.7147,
      "end": 27.4797,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/b1f10b64a82a2979.trim.wav"
    },
    {
      "i": 13,
      "text": "Đầu ra mười đô, đúng một phần năm giá Astra.",
      "start": 27.587,
      "end": 29.593,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/8b47eeb9904c1440.trim.wav"
    },
    {
      "i": 14,
      "text": "Trên bài test lập trình DeepSWE, Sol ngang Astra.",
      "start": 29.6983,
      "end": 31.9963,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/77e6c2cda57cff8e.trim.wav"
    },
    {
      "i": 15,
      "text": "Với bài khoa học, Sol tốn năm phẩy bốn bảy đô mỗi tác vụ.",
      "start": 32.1084,
      "end": 34.6554,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/0cf2935ec483fae3.trim.wav"
    },
    {
      "i": 16,
      "text": "Astra tốn hai mươi ba phẩy tám đô, gấp hơn bốn lần.",
      "start": 34.7754,
      "end": 37.0074,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/ad0520cae6ad8b82.trim.wav"
    },
    {
      "i": 17,
      "text": "Dù vậy, Astra vẫn đứng đầu về điểm số.",
      "start": 37.119,
      "end": 38.839,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/a5dc7ee8f0080cec.trim.wav"
    },
    {
      "i": 18,
      "text": "Nhưng dots chưa dành cho tất cả mọi người.",
      "start": 38.9429,
      "end": 40.7869,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/e91d7ea565d2082e.trim.wav"
    },
    {
      "i": 19,
      "text": "Đợt đầu chỉ có gói Pro và Business Premium.",
      "start": 40.8964,
      "end": 42.9924,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/6a47443f9dbe240b.trim.wav"
    },
    {
      "i": 20,
      "text": "Theo WIRED, gói Pro giá một trăm đô mỗi tháng.",
      "start": 43.1079,
      "end": 45.1909,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/f98b7f49a83ce4ce.trim.wav"
    },
    {
      "i": 21,
      "text": "Ngay trên sân khấu, dot còn liên tục lỗi giọng nói.",
      "start": 45.2998,
      "end": 47.5858,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/edfedf355653aa39.trim.wav"
    },
    {
      "i": 22,
      "text": "Romain Huet thừa nhận giọng nói có thể đang trục trặc.",
      "start": 47.6897,
      "end": 50.0158,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/fbe5d8c71023a60f.trim.wav"
    },
    {
      "i": 23,
      "text": "Khi AI làm thay hai bốn trên bảy, bạn sẽ làm gì?",
      "start": 50.1358,
      "end": 52.2548,
      "file": "/workspace/video-jobs/EDIT-FULL-02/lam-viec/tts_cache/ff5e4b5075578f12.trim.wav"
    }
  ],
