{
  "sentences": [
    {
      "i": 0,
      "text": "Meta vừa dùng AI giải năm bài toán nghiên cứu chưa có lời giải.",
      "start": 0.0,
      "end": 2.805,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/31ee06de1090f2f4.trim.wav"
    },
    {
      "i": 1,
      "text": "Nhưng đây không phải đề thi có sẵn đáp án.",
      "start": 2.925,
      "end": 4.777,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/1d4c56148ac25ee1.trim.wav"
    },
    {
      "i": 2,
      "text": "Điều đáng nói: AI bắt đầu giúp tạo kiến thức mới.",
      "start": 4.897,
      "end": 6.999,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/77f3ef21facf0afd.trim.wav"
    },
    {
      "i": 3,
      "text": "Ngày hai tháng mười, Meta công bố Muse Spark.",
      "start": 7.119,
      "end": 9.242,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/d3dbc931b1dc3d37.trim.wav"
    },
    {
      "i": 4,
      "text": "Các nhà toán học cùng AI viết sáu bài báo nghiên cứu.",
      "start": 9.362,
      "end": 11.719,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/4551c075666f57e4.trim.wav"
    },
    {
      "i": 5,
      "text": "Năm bài đưa ra lời giải cho câu hỏi trước đó bỏ ngỏ.",
      "start": 11.839,
      "end": 13.969,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/2cdcc7d1c62319c9.trim.wav"
    },
    {
      "i": 6,
      "text": "Đầu năm, mô hình Meta đạt huy chương vàng ở năm kỳ Olympiad.",
      "start": 14.089,
      "end": 16.886,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/11e7ccaa6b7aadd9.trim.wav"
    },
    {
      "i": 7,
      "text": "Nhưng bài toán nghiên cứu mở thì khác: không có chìa đáp án.",
      "start": 17.006,
      "end": 19.76,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/f8d381539684ac8c.trim.wav"
    },
    {
      "i": 8,
      "text": "Con người dẫn dắt, AI là cộng sự ngay trong chat meta chấm ai.",
      "start": 19.88,
      "end": 22.734,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/16b05a1089ccee32.trim.wav"
    },
    {
      "i": 9,
      "text": "Nhóm thứ hai thẩm định từng lập luận.",
      "start": 22.854,
      "end": 24.409,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/139030d428c5b248.trim.wav"
    },
    {
      "i": 10,
      "text": "Mỗi đoạn đánh dấu rõ người viết hay AI soạn.",
      "start": 24.529,
      "end": 26.385,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/8d41ee8899cb887b.trim.wav"
    },
    {
      "i": 11,
      "text": "Có bài bác giả thuyết năm hai không hai tư.",
      "start": 26.505,
      "end": 28.36,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/c50f658b25a40d68.trim.wav"
    },
    {
      "i": 12,
      "text": "Phản ví dụ là một nhóm có ba trăm tám mươi bốn phần tử.",
      "start": 28.48,
      "end": 30.878,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/86e70de61fe84142.trim.wav"
    },
    {
      "i": 13,
      "text": "Có bài xác nhận sóng phải sụp đổ trong thời gian hữu hạn.",
      "start": 30.998,
      "end": 33.473,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/6d6ffd56cc5213ce.trim.wav"
    },
    {
      "i": 14,
      "text": "Đó là câu hỏi bỏ ngỏ từ năm hai không một năm.",
      "start": 33.593,
      "end": 35.574,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/1692ada1433833be.trim.wav"
    },
    {
      "i": 15,
      "text": "Cùng đợt, Meta mở Muse Gadgets.",
      "start": 35.694,
      "end": 37.223,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/7e2c62a84fedabe6.trim.wav"
    },
    {
      "i": 16,
      "text": "Phần cứng nguồn mở để ai cũng chạy cùng Muse.",
      "start": 37.343,
      "end": 39.464,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/5b8471b2ab241b2d.trim.wav"
    },
    {
      "i": 17,
      "text": "Năm nghìn chiếc Muse Home Link tặng người đăng ký.",
      "start": 39.584,
      "end": 41.724,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/ef5b60e2be201be5.trim.wav"
    },
    {
      "i": 18,
      "text": "Nhưng Meta tự công bố, bài báo chưa qua bình duyệt tạp chí.",
      "start": 41.844,
      "end": 44.525,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/f57192ee9d6d5137.trim.wav"
    },
    {
      "i": 19,
      "text": "Một số bài toán đã được nhóm khác giải độc lập.",
      "start": 44.645,
      "end": 46.567,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/e7496c9edf3a0bd5.trim.wav"
    },
    {
      "i": 20,
      "text": "Chuyên gia cộng AI chat thường đã tạo kết quả cấp nghiên cứu.",
      "start": 46.687,
      "end": 49.323,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/e9d8815f53118958.trim.wav"
    },
    {
      "i": 21,
      "text": "Theo dõi Hinton Media để không lỡ tin AI mỗi ngày.",
      "start": 49.443,
      "end": 51.737,
      "file": "/workspace/video-jobs/HM-101/lam-viec/tts_cache/c0dfa72033e37044.trim.wav"
    }
  ],
