{
  "sentences": [
    {
      "i": 0,
      "text": "Bé gái đạp xe ra giữa quốc lộ.",
      "start": 0.0,
      "end": 1.379,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/c5e41d611e6a0e0c.trim.wav"
    },
    {
      "i": 1,
      "text": "Nhưng bé khựng giữa làn.",
      "start": 1.4822,
      "end": 2.5732,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/c2d23c878ac2a9c8.trim.wav"
    },
    {
      "i": 2,
      "text": "Bé sống trong một căn nhà mặt đường.",
      "start": 2.6713,
      "end": 4.1643,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/db7d01bc210e3ff5.trim.wav"
    },
    {
      "i": 3,
      "text": "Váy hồng, xe nhỏ, từ lối trái.",
      "start": 4.2704,
      "end": 5.6474,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/246c0007ed79a304.trim.wav"
    },
    {
      "i": 4,
      "text": "Bé dừng giữa làn gần và đứng im.",
      "start": 5.7525,
      "end": 7.2155,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/b88e042ef651befb.trim.wav"
    },
    {
      "i": 5,
      "text": "Xe máy vượt làn gần, bé không nhích.",
      "start": 7.3212,
      "end": 8.9202,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/cc9586c4e08e7bf4.trim.wav"
    },
    {
      "i": 6,
      "text": "Khoảng mười giây, bé vẫn đứng nhìn lạc.",
      "start": 9.0334,
      "end": 10.7324,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/52d391dd7f1eea75.trim.wav"
    },
    {
      "i": 7,
      "text": "Bé vẫn ngơ, không né dòng xe.",
      "start": 10.831,
      "end": 12.206,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/6714bcec6610f19a.trim.wav"
    },
    {
      "i": 8,
      "text": "Nhưng các tài xế đã thấy.",
      "start": 12.3141,
      "end": 13.5701,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/e174fb6f0321e06f.trim.wav"
    },
    {
      "i": 9,
      "text": "Xe bán tải trắng ở làn xa dừng lại.",
      "start": 13.6812,
      "end": 15.2402,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/06bf7d5c76df32d1.trim.wav"
    },
    {
      "i": 10,
      "text": "Xe tải thùng phía sau cũng phanh.",
      "start": 15.3505,
      "end": 16.6905,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/63f9642e1ce867e5.trim.wav"
    },
    {
      "i": 11,
      "text": "Hai làn dừng, chờ người trong nhà.",
      "start": 16.8019,
      "end": 18.1809,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/a91bc92bb8c1218d.trim.wav"
    },
    {
      "i": 12,
      "text": "Người lớn phóng ra từ bên trái.",
      "start": 18.2896,
      "end": 19.6576,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/b4a55bbce51cc464.trim.wav"
    },
    {
      "i": 13,
      "text": "Người đàn ông túm đuôi xe, kéo bé lùi khỏi làn.",
      "start": 19.7614,
      "end": 21.8074,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/8c71352fbc7d4ff1.trim.wav"
    },
    {
      "i": 14,
      "text": "Bé và xe ra khỏi đường, khuất khung.",
      "start": 21.911,
      "end": 23.463,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/1c683fad1bc53cf8.trim.wav"
    },
    {
      "i": 15,
      "text": "Clip gốc dài hai mươi ba giây.",
      "start": 23.5679,
      "end": 24.8319,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/f5e586fbf27eb9c6.trim.wav"
    },
    {
      "i": 16,
      "text": "Nhà sát đường, một nhịp là tới làn.",
      "start": 24.9371,
      "end": 26.4021,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/aa995a634aec29cc.trim.wav"
    },
    {
      "i": 17,
      "text": "Đừng để trẻ một mình gần làn xe.",
      "start": 26.5067,
      "end": 27.9883,
      "file": "/workspace/video-jobs/FB-BE-GAI-QUOC-LO/lam-viec/tts_cache/c9a3d2e9b526e847.trim.wav"
    }
  ],
