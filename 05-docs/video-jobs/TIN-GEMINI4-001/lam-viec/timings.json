{
  "sentences": [
    {
      "i": 0,
      "text": "Google vừa tung mô hình mạnh nhất từ trước tới nay.",
      "start": 0.0,
      "end": 2.237,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/79d28f4bebdf8a41.trim.wav"
    },
    {
      "i": 1,
      "text": "Nhưng bạn chưa được dùng.",
      "start": 2.357,
      "end": 3.646,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/aae13d6911e4f027.trim.wav"
    },
    {
      "i": 2,
      "text": "Ngày ba mươi tháng chín năm hai nghìn không trăm hai mươi sáu, Google công bố Gemini bốn Argon.",
      "start": 3.766,
      "end": 8.223,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/63292c17397212a9.trim.wav"
    },
    {
      "i": 3,
      "text": "Đợt đầu chỉ phát cho nhóm chuyên gia an ninh mạng qua chương trình Fairwind.",
      "start": 8.343,
      "end": 11.714,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/647b4094485119f1.trim.wav"
    },
    {
      "i": 4,
      "text": "Chưa có lịch mở rộng.",
      "start": 11.834,
      "end": 12.926,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/d017a60c01906996.trim.wav"
    },
    {
      "i": 5,
      "text": "Đầu ra tăng lên một triệu token, gấp hơn mười lăm lần mức sáu mươi bốn nghìn trước đây.",
      "start": 13.046,
      "end": 17.168,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/fb3276c40143a181.trim.wav"
    },
    {
      "i": 6,
      "text": "Giá mở màn hai đô la mỗi triệu token vào, mười đô la mỗi triệu token ra.",
      "start": 17.288,
      "end": 20.558,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/9cd5f2fa24517168.trim.wav"
    },
    {
      "i": 7,
      "text": "Trên DeepSWE, Argon đạt bảy mươi bảy phẩy chín phần trăm.",
      "start": 20.678,
      "end": 23.3,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/b5dac1fe61be4234.trim.wav"
    },
    {
      "i": 8,
      "text": "AutomationBench năm mươi mốt phẩy ba.",
      "start": 23.42,
      "end": 25.165,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/368d8fd382a13b8e.trim.wav"
    },
    {
      "i": 9,
      "text": "LVBench chín mươi mốt phẩy bảy.",
      "start": 25.285,
      "end": 26.713,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/ef53e9f02a171ce3.trim.wav"
    },
    {
      "i": 10,
      "text": "Reuters lưu ý Argon vẫn thua ở hai trong bốn bài lập trình Google tự đưa.",
      "start": 26.833,
      "end": 30.193,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/5ccdcce2ecdb1a45.trim.wav"
    },
    {
      "i": 11,
      "text": "Bên trong Google, Argon giúp giải phóng hơn ba trăm tebibyte bộ nhớ.",
      "start": 30.313,
      "end": 33.572,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/b3f520f01caf096f.trim.wav"
    },
    {
      "i": 12,
      "text": "Hơn tám trăm nghìn dòng C chuyển sang Rust.",
      "start": 33.692,
      "end": 35.633,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/8e9bc254aa66e3f6.trim.wav"
    },
    {
      "i": 13,
      "text": "Giải mã video nhanh gấp hai phẩy bảy lần.",
      "start": 35.753,
      "end": 37.623,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/1997aaa5b0b5051a.trim.wav"
    },
    {
      "i": 14,
      "text": "Google bỏ hẳn Gemini ba phẩy năm Pro sau nhiều tháng trì hoãn.",
      "start": 37.743,
      "end": 40.588,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/b6fc591d259e97cf.trim.wav"
    },
    {
      "i": 15,
      "text": "Argon lớn hơn dòng Pro.",
      "start": 40.708,
      "end": 41.897,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/70ba0ade567a03ca.trim.wav"
    },
    {
      "i": 16,
      "text": "Khi AI mạnh nhất chỉ dành cho hiệp sĩ an ninh mạng, bạn nghĩ gì?",
      "start": 42.017,
      "end": 44.83,
      "file": "/workspace/video-jobs/TIN-GEMINI4-001/lam-viec/tts_cache/fd0af0b5c926b072.trim.wav"
    }
  ],
