{
  "sentences": [
    {
      "i": 0,
      "text": "Lần đầu tiên, một mô hình trí tuệ nhân tạo góp phần mang về giải Nobel Hóa học.",
      "start": 0.0,
      "end": 3.538,
      "file": "/workspace/video-jobs/TEST-pipeline-001/lam-viec/tts_cache/5000642d770a75bf.trim.wav"
    },
    {
      "i": 1,
      "text": "Tháng mười năm hai nghìn không trăm hai mươi bốn, Viện Hàn lâm Khoa học Hoàng gia Thụy Điển trao một nửa giải cho Demis Hassabis và John Jumper của Google DeepMind,",
      "start": 3.658,
      "end": 11.66,
      "file": "/workspace/video-jobs/TEST-pipeline-001/lam-viec/tts_cache/11f340290e8a4681.trim.wav"
    },
    {
      "i": 2,
      "text": "nhờ công trình dự đoán cấu trúc protein bằng AlphaFold.",
      "start": 11.78,
      "end": 14.457,
      "file": "/workspace/video-jobs/TEST-pipeline-001/lam-viec/tts_cache/2e5a74f2af189899.trim.wav"
    },
    {
      "i": 3,
      "text": "Nửa còn lại thuộc về giáo sư David Baker, với công trình thiết kế protein bằng máy tính.",
      "start": 14.577,
      "end": 18.71,
      "file": "/workspace/video-jobs/TEST-pipeline-001/lam-viec/tts_cache/f9bb27a357d3a74c.trim.wav"
    }
  ],
